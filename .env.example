# Stripe keys (get from dashboard.stripe.com → Developers → API keys)
# For testing, use test keys. For production, switch to live keys.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Site URL (change to production domain later)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (for image uploads)
# Optional for local development (uploads fall back to temporary URLs).
# For production, create a Cloudinary account and add credentials here.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Resend recommended)
# Sign up at resend.com, get API key, and set sender domain.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=solnichki@gmail.com
